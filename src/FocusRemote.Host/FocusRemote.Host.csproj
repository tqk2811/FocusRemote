<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<UseWPF>true</UseWPF>
		<RootNamespace>FocusRemote.Host</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AssemblyName>FocusRemote.Host</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="QRCoder" Version="1.6.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FocusRemote.Host.Core\FocusRemote.Host.Core.csproj" />
	</ItemGroup>

	<!-- WebViewer for LAN mode: linked from the Relay project so both always serve the same files. -->
	<ItemGroup>
		<Content Include="..\FocusRemote.Relay\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
