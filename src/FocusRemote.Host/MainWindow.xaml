<Window x:Class="FocusRemote.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusRemote Host" Width="760" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <GroupBox Header="Cài đặt" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Relay URL" Target="{Binding ElementName=RelayUrlBox}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RelayUrlBox" Margin="0,2"
                             ToolTip="Ví dụ https://relay.example.com (để trống nếu chỉ dùng LAN)" />

                    <Label Grid.Row="1" Content="Id" Target="{Binding ElementName=IdBox}" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="IdBox" Margin="0,2"
                             ToolTip="3–64 ký tự A-Z a-z 0-9 _ -" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Ngẫu nhiên" Margin="6,2,0,2" Padding="8,0" Click="RandomId_Click" />

                    <Label Grid.Row="2" Content="Password" Target="{Binding ElementName=PasswordBox}" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox" Margin="0,2"
                             ToolTip="Tối thiểu 10 ký tự. Không lưu password, chỉ lưu khoá đã suy ra (DPAPI)." />
                    <Button Grid.Row="2" Grid.Column="2" Content="Ngẫu nhiên" Margin="6,2,0,2" Padding="8,0" Click="RandomPassword_Click" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PasswordHint" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="LanEnabledBox" Content="Bật chế độ LAN (HTTPS tự ký, chạy cùng relay ngoài)" Margin="4,6" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="6,2,0,2">
                        <Label Content="Cổng" Padding="0,0,4,0" VerticalAlignment="Center" />
                        <TextBox x:Name="LanPortBox" Width="60" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <CheckBox Grid.Row="5" Grid.ColumnSpan="3" x:Name="StartWithWindowsBox" Content="Khởi động cùng Windows" Margin="4,4" />

                    <CheckBox Grid.Row="6" Grid.ColumnSpan="3" x:Name="TerminalEnabledBox" Content="Cho phép terminal từ xa (toàn quyền chạy lệnh trên máy này)" Margin="4,4" />

                    <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="StartButton" Content="Lưu và bắt đầu" Padding="12,4" Click="Start_Click" IsDefault="True" />
                        <Button x:Name="StopButton" Content="Dừng" Padding="12,4" Margin="8,0,0,0" Click="Stop_Click" IsEnabled="False" />
                        <Button Content="Mở thư mục log" Padding="12,4" Margin="8,0,0,0" Click="OpenLogs_Click" />
                    </StackPanel>
                    <TextBlock Grid.Row="8" Grid.ColumnSpan="3" x:Name="SettingsError" Foreground="Firebrick" TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Trạng thái" Padding="8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Relay:" FontWeight="SemiBold" Margin="0,2,8,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RelayStatusText" TextWrapping="Wrap" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Viewer:" FontWeight="SemiBold" Margin="0,2,8,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ViewerStatusText" TextWrapping="Wrap" Margin="0,2" />
                    <TextBlock Grid.Row="2" Text="Encoder:" FontWeight="SemiBold" Margin="0,2,8,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EncoderStatusText" TextWrapping="Wrap" Margin="0,2" />
                </Grid>
            </GroupBox>

            <GroupBox Header="LAN" Padding="8" Margin="0,8,0,0" x:Name="LanGroup">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="LanStatusText" TextWrapping="Wrap" />
                        <TextBox x:Name="LanUrlsBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" Margin="0,6,0,0" MinHeight="48" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,6,0,0"
                                   Text="Trình duyệt sẽ cảnh báo chứng chỉ tự ký: chấp nhận một lần rồi nhập Id + password như với relay." />
                        <TextBlock x:Name="FirewallText" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBox x:Name="FirewallCommandBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                        <Button x:Name="FirewallButton" Content="Thêm firewall rule" HorizontalAlignment="Left" Padding="12,4" Margin="0,6,0,0" Click="Firewall_Click" Visibility="Collapsed" />
                    </StackPanel>
                    <Image Grid.Column="1" x:Name="QrImage" Width="180" Height="180" Margin="12,0,0,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
