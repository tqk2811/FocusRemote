<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<RootNamespace>FocusRemote.E2E</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\FocusRemote.Host.Core\FocusRemote.Host.Core.csproj" />
	</ItemGroup>

	<!-- Same WebViewer files as the Relay, for LAN mode. -->
	<ItemGroup>
		<Content Include="..\FocusRemote.Relay\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
