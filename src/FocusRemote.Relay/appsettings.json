{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Relay": {
    "MaxMessageBytes": 16777216,
    "ViewerConnectPerMinute": 20,
    "KeepAliveSeconds": 15,
    "UseForwardedHeaders": false,
    "ForwardedForHeader": "X-Forwarded-For",
    "TrustedProxies": []
  }
}
